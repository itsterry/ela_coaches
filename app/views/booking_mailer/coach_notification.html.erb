<p>Hello <%= slot.availability.coach.firstname %>,</p>

<p>A new slot has been booked.</p>

<ul>
  <li><strong>Player:</strong> <%= slot.player_name %></li>
  <li><strong>Parent:</strong> <%= slot.parent_name %> (<%= slot.parent_email %>)</li>
  <li><strong>Date:</strong> <%= slot.availability.date.to_fs(:long) %></li>
  <li><strong>Time:</strong> <%= slot.start_time.strftime("%H:%M") %> (<%= slot.availability.slot_length %> minutes)</li>
  <li><strong>Where:</strong> <%= slot.availability.location %></li>
</ul>

<p>Reply to this email to contact the parent.</p>
