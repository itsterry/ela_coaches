<% content_for :title, "Reset your password" %>

<div class="row justify-content-center">
  <div class="col-12 col-md-6 col-lg-4">
    <div class="card shadow-sm">
      <div class="card-body">
        <h1 class="h4 mb-3">Forgot your password?</h1>

        <%= form_with url: passwords_path, class: "vstack gap-3" do |form| %>
          <div>
            <%= form.label :email, class: "form-label" %>
            <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", class: "form-control", value: params[:email] %>
          </div>
          <%= form.submit "Email reset instructions", class: "btn btn-primary" %>
        <% end %>

        <p class="mt-3 mb-0"><%= link_to "Back to sign in", new_session_path %></p>
      </div>
    </div>
  </div>
</div>
